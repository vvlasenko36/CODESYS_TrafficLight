                <Null Name="Tag" />
                <Single Name="Text" Type="string">    1: tTimeLeft1 := (GVL.T_GREEN_ON + GVL.T_GREEN_BLINK + GVL.T_YELLOW_ON) - fbTimer.ET;</Single>
              </Single>
